#!/bin/bash

# PHP Formatter for Zed Editor
# Formats PHP using Laravel Pint with the project's own pint.json ruleset,
# so format-on-save produces exactly the same output as `./vendor/bin/pint`.
#
# Zed contract: the buffer is passed on STDIN, the formatted result must be
# written to STDOUT. The real file path is passed as $1 ({buffer_path}) and is
# used only to locate the project root / pint.json and to keep the extension.
#
# Configure in Zed settings.json:
# "languages": {
#   "PHP": {
#     "format_on_save": "on",
#     "formatter": {
#       "external": {
#         "command": "~/.dotfiles/bin/php-format",
#         "arguments": ["{buffer_path}"]
#       }
#     }
#   }
# }

set -euo pipefail

BUFFER_PATH="${1:-}"

find_project_root() {
    local dir="$1"
    while [ -n "$dir" ] && [ "$dir" != "/" ]; do
        if [ -f "$dir/composer.json" ]; then
            echo "$dir"
            return
        fi
        dir=$(dirname "$dir")
    done
    echo ""
}

PROJECT_ROOT=""
if [ -n "$BUFFER_PATH" ]; then
    PROJECT_ROOT=$(find_project_root "$(dirname "$BUFFER_PATH")")
fi

# Work on a temp copy of the STDIN buffer (Pint formats files, not stdin).
TMP_FILE=$(mktemp -t php-format.XXXXXX.php)
trap 'rm -f "$TMP_FILE"' EXIT
cat > "$TMP_FILE"

# Resolve a Pint binary: project-local, then global, then Composer global.
PINT=""
if [ -n "$PROJECT_ROOT" ] && [ -x "$PROJECT_ROOT/vendor/bin/pint" ]; then
    PINT="$PROJECT_ROOT/vendor/bin/pint"
elif command -v pint &>/dev/null; then
    PINT="pint"
elif [ -x "$HOME/.composer/vendor/bin/pint" ]; then
    PINT="$HOME/.composer/vendor/bin/pint"
fi

# No Pint available: return the buffer unchanged.
if [ -z "$PINT" ]; then
    cat "$TMP_FILE"
    exit 0
fi

# Use the project's pint.json so the ruleset matches the repo exactly.
if [ -n "$PROJECT_ROOT" ] && [ -f "$PROJECT_ROOT/pint.json" ]; then
    "$PINT" "$TMP_FILE" --config "$PROJECT_ROOT/pint.json" --quiet >/dev/null 2>&1 || true
else
    "$PINT" "$TMP_FILE" --quiet >/dev/null 2>&1 || true
fi

cat "$TMP_FILE"
