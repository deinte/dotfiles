#!/usr/bin/env bash
set -euo pipefail

ROOT="${AGENT_WORKSTATION_ROOT:-$HOME/agent-workstation}"
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
DRY_RUN=false

usage() { printf '%s\n' 'Usage: install-linux-devstation [--dry-run]'; }
while (($#)); do
  case "$1" in
    --dry-run) DRY_RUN=true; shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done

say() { printf '%s\n' "$*"; }
run() { if "$DRY_RUN"; then say "DRY-RUN: $*"; else "$@"; fi; }
backup_path() { printf '%s.backup-%s' "$1" "$(date -u +%Y%m%dT%H%M%SZ%N)"; }

if [[ ! -f "$SCRIPT_DIR/agent-task" || ! -f "$SCRIPT_DIR/workstation-doctor" ]]; then
  echo "ERROR: installer assets not found beside $SCRIPT_DIR" >&2
  exit 1
fi

for dir in repos worktrees artifacts runs locks scripts; do
  [[ -d "$ROOT/$dir" ]] || run mkdir -p "$ROOT/$dir"
done
run mkdir -p "$HOME/.local/bin"

install_asset() {
  local source="$1" destination="$2"
  if [[ -f "$destination" ]] && cmp -s "$source" "$destination"; then
    [[ "$(stat -c '%a' "$destination" 2>/dev/null || stat -f '%Lp' "$destination")" == 700 ]] || run chmod 700 "$destination"
    say "OK: $destination already matches"
    return
  fi
  if [[ -e "$destination" || -L "$destination" ]]; then
    local backup; backup="$(backup_path "$destination")"
    run cp -p "$destination" "$backup"
    say "BACKUP: $destination -> $backup"
  fi
  run cp "$source" "$destination"
  run chmod 700 "$destination"
  say "INSTALL: $destination"
}

install_asset "$SCRIPT_DIR/agent-task" "$ROOT/scripts/agent-task"
install_asset "$SCRIPT_DIR/workstation-doctor" "$ROOT/scripts/workstation-doctor"

link_command() {
  local target="$1" link
  link="$HOME/.local/bin/$(basename "$target")"
  if [[ -L "$link" && "$(readlink "$link")" == "$target" ]]; then
    say "OK: $link already points to $target"
  elif [[ -e "$link" || -L "$link" ]]; then
    local backup; backup="$(backup_path "$link")"
    run mv "$link" "$backup"
    run ln -s "$target" "$link"
    say "BACKUP: $link -> $backup"
  else
    run ln -s "$target" "$link"
    say "LINK: $link -> $target"
  fi
}
link_command "$ROOT/scripts/agent-task"
link_command "$ROOT/scripts/workstation-doctor"
link_command "$SCRIPT_DIR/workstation-sync"
say "Linux dev-workstation assets are ready under $ROOT"
