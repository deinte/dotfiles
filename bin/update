#!/bin/bash

set -e

DOTFILES="$HOME/.dotfiles"

# Colors for output
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

info() { echo -e "${BLUE}[INFO]${NC} $1"; }
success() { echo -e "${GREEN}[OK]${NC} $1"; }

echo ""
echo "╔══════════════════════════════════════════════════════════════╗"
echo "║                     Updating Dotfiles                         ║"
echo "╚══════════════════════════════════════════════════════════════╝"
echo ""

# ─────────────────────────────────────────────────────────────────────
# Update dotfiles repo
# ─────────────────────────────────────────────────────────────────────
info "Pulling latest dotfiles..."
cd "$DOTFILES"
git pull origin main 2>/dev/null || git pull origin master 2>/dev/null || true
success "Dotfiles updated"

# ─────────────────────────────────────────────────────────────────────
# Update Homebrew and packages
# ─────────────────────────────────────────────────────────────────────
info "Updating Homebrew..."
brew update
success "Homebrew updated"

info "Upgrading Homebrew packages..."
brew upgrade
success "Packages upgraded"

info "Installing new packages from Brewfile..."
brew bundle --file="$DOTFILES/config/Brewfile" || true
success "Brewfile processed"

info "Cleaning up Homebrew..."
brew cleanup
success "Homebrew cleaned"

# ─────────────────────────────────────────────────────────────────────
# Update Oh My Zsh
# ─────────────────────────────────────────────────────────────────────
info "Updating Oh My Zsh..."
if [ -d "$HOME/.oh-my-zsh" ]; then
    cd "$HOME/.oh-my-zsh"
    git pull origin master --quiet
    success "Oh My Zsh updated"
fi

# ─────────────────────────────────────────────────────────────────────
# Update global Composer packages
# ─────────────────────────────────────────────────────────────────────
info "Updating global Composer packages..."
if command -v composer &>/dev/null; then
    composer global update --quiet
    success "Composer packages updated"
fi

# ─────────────────────────────────────────────────────────────────────
# Update Node via FNM
# ─────────────────────────────────────────────────────────────────────
info "Checking Node updates..."
if command -v fnm &>/dev/null; then
    fnm install --lts
    success "Node LTS updated"
fi

# ─────────────────────────────────────────────────────────────────────
# Update Claude Code
# ─────────────────────────────────────────────────────────────────────
info "Updating Claude Code CLI..."
if command -v claude &>/dev/null; then
    claude update 2>/dev/null || true
    success "Claude Code CLI updated"
fi

info "Updating Claude Code plugins..."
if command -v claude &>/dev/null; then
    claude plugin list 2>/dev/null | sed -n 's/.*❯ \(.*\)/\1/p' | while read -r plugin; do
        info "  Updating plugin: $plugin"
        claude plugin update "$plugin" 2>/dev/null || true
    done
    success "Claude Code plugins updated"
fi

info "Refreshing Claude Code config symlinks..."
mkdir -p ~/.claude
for dir in agents skills commands hooks plugins get-shit-done; do
    if [ -d "$DOTFILES/config/claude/$dir" ]; then
        rm -rf ~/.claude/$dir
        ln -sf "$DOTFILES/config/claude/$dir" ~/.claude/$dir
    fi
done
for file in settings.json CLAUDE.md; do
    if [ -f "$DOTFILES/config/claude/$file" ]; then
        ln -sf "$DOTFILES/config/claude/$file" ~/.claude/$file
    fi
done
success "Claude Code config refreshed"

# ─────────────────────────────────────────────────────────────────────
# Done!
# ─────────────────────────────────────────────────────────────────────
echo ""
success "All updates complete!"
echo ""
