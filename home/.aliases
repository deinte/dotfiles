# ─────────────────────────────────────────────────────────────────────
# PHP / Laravel / Composer
# ─────────────────────────────────────────────────────────────────────

# Artisan
alias a="php artisan"
alias tinker="php artisan tinker"
alias migrate="php artisan migrate"
alias fresh="php artisan migrate:fresh --seed"
alias seed="php artisan db:seed"

# Composer
alias c="composer"
alias cu="composer update"
alias ci="composer install"
alias cr="composer require"
alias crd="composer require --dev"
alias cda="composer dump-autoload"

# Testing
alias pest="./vendor/bin/pest"
alias pint="./vendor/bin/pint"
alias phpunit="./vendor/bin/phpunit"

# Valet PHP version switching
alias vphp="valet php"
alias vphp74="valet use php@7.4"
alias vphp80="valet use php@8.0"
alias vphp81="valet use php@8.1"
alias vphp82="valet use php@8.2"
alias vphp83="valet use php@8.3"
alias vphp84="valet use php@8.4"

# ─────────────────────────────────────────────────────────────────────
# Modern CLI Replacements
# ─────────────────────────────────────────────────────────────────────

# eza (better ls)
if command -v eza &>/dev/null; then
    alias ls="eza --icons"
    alias ll="eza -la --icons --git"
    alias la="eza -a --icons"
    alias lt="eza --tree --level=2 --icons"
    alias llt="eza -la --tree --level=2 --icons --git"
fi

# bat (better cat)
if command -v bat &>/dev/null; then
    alias cat="bat --paging=never"
    alias catp="bat"  # with pager
fi

# ripgrep (better grep)
if command -v rg &>/dev/null; then
    alias grep="rg"
fi

# bottom (better htop/top)
if command -v btm &>/dev/null; then
    alias htop="btm"
    alias top="btm"
fi

# fd (better find)
if command -v fd &>/dev/null; then
    alias find="fd"
fi

# ─────────────────────────────────────────────────────────────────────
# Git
# ─────────────────────────────────────────────────────────────────────
alias gs="git status"
alias gp="git push"
alias gl="git pull"
alias gf="git fetch --all --prune"
alias gco="git checkout"
alias gcb="git checkout -b"
alias gc="git commit"
alias gcm="git commit -m"
alias gca="git commit --amend"
alias ga="git add"
alias gaa="git add --all"
alias gd="git diff"
alias gds="git diff --staged"
alias glog="git log --oneline --graph --decorate -20"
alias gst="git stash"
alias gstp="git stash pop"
alias grb="git rebase"
alias grbi="git rebase -i"
alias gm="git merge"

# ─────────────────────────────────────────────────────────────────────
# Claude Code
# ─────────────────────────────────────────────────────────────────────
alias cl="claude"

# ─────────────────────────────────────────────────────────────────────
# General Utilities
# ─────────────────────────────────────────────────────────────────────
alias o="open ."
alias c="clear"
alias q="exit"
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."

# Open current directory in GitKraken
alias kraken="open gitkraken://repo/\$PWD"

# System
alias hostfile="sudo vim /etc/hosts"
alias flushdns="sudo dscacheutil -flushcache && sudo killall -HUP mDNSResponder"
alias ip="curl -s ipinfo.io | jq -r '.ip'"
alias localip="ipconfig getifaddr en0"

# Reload shell config
alias reload="source ~/.zshrc"

# Show/hide hidden files in Finder
alias showfiles="defaults write com.apple.finder AppleShowAllFiles YES && killall Finder"
alias hidefiles="defaults write com.apple.finder AppleShowAllFiles NO && killall Finder"

# ─────────────────────────────────────────────────────────────────────
# Directory Shortcuts
# ─────────────────────────────────────────────────────────────────────
alias dotfiles="cd ~/.dotfiles"
alias sites="cd ~/Sites"
alias projects="cd ~/Documents/Projecten"
