# Dotfiles Brewfile
# Install with: brew bundle --file=~/.dotfiles/config/Brewfile

# ─────────────────────────────────────────────────────────────────────
# Taps (must be first)
# ─────────────────────────────────────────────────────────────────────
tap "nicoverbruggen/cask"  # For PHP Monitor

# ─────────────────────────────────────────────────────────────────────
# CLI Tools
# ─────────────────────────────────────────────────────────────────────

# Git & GitHub
brew "gh"
brew "hub"
brew "git-secret"
brew "git-delta"       # Better diffs

# PHP Development
brew "php"
brew "composer"

# Media processing
brew "imagemagick"
brew "ghostscript"

# Modern CLI replacements
brew "zoxide"          # Smart cd (replaces z)
brew "bat"             # Better cat
brew "eza"             # Better ls
brew "fd"              # Better find
brew "ripgrep"         # Better grep
brew "fzf"             # Fuzzy finder
brew "bottom"          # Better htop

# Shell & Prompt
brew "starship"        # Modern prompt
brew "zsh-autosuggestions"
brew "zsh-completions"

# Node.js
brew "fnm"             # Fast Node Manager (replaces nvm)

# Utilities
brew "httpie"          # Better curl
brew "wget"
brew "ncdu"            # Disk usage analyzer
brew "jq"              # JSON processor
brew "yq"              # YAML processor
brew "direnv"          # Per-project env vars

# ─────────────────────────────────────────────────────────────────────
# GUI Applications
# ─────────────────────────────────────────────────────────────────────

# Development
cask "warp"            # Modern terminal
cask "zed"             # Fast code editor
cask "jetbrains-toolbox"
cask "docker"          # Docker Desktop

# PHP/Laravel Tools
cask "nicoverbruggen/cask/phpmon"  # PHP version manager UI
cask "dbngin"          # Database server manager
cask "tableplus"       # Database GUI
cask "ray"             # Laravel Ray debugger

# Browsers
cask "vivaldi"         # Power-user browser
cask "google-chrome"   # For testing/DevTools

# Productivity
cask "raycast"         # Spotlight replacement
cask "claude"          # Claude desktop app
cask "claude-code"     # Claude CLI
cask "1password"       # Password manager
cask "1password-cli"   # 1Password CLI (for SSH keys)
cask "cleanshot"       # Screenshot tool
cask "readdle-spark"   # Email client
cask "slack"           # Team communication

# Utilities
cask "imageoptim"      # Image compression
brew "imageoptim-cli"  # CLI for git hooks
cask "yaak"            # API client

# ─────────────────────────────────────────────────────────────────────
# Fonts
# ─────────────────────────────────────────────────────────────────────
cask "font-meslo-lg-nerd-font"

